---
import VideoHeroLayout from '../../layouts/VideoHeroLayout.astro';
import ServiceIntro from '../../components/ServiceIntro.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import MenuBlocks from '../../components/menus/MenuBlocks.astro';
import ServiceMenuDownloads from '../../components/ServiceMenuDownloads.astro';
import { serviceFaqs } from '../../data/faq-content.js';
import { eyesMenu } from '../../data/menus/eyes';
import { FRESHA_BOOKING_URL } from '../../data/site-urls.js';

const eyesRows = eyesMenu.blocks.filter((b) => b.type === 'simpleRow');
const eyesComing = eyesMenu.blocks.find((b) => b.type === 'comingSoon');
---

<VideoHeroLayout
  title="Eye treatments & brows | Sara Monse Beauty"
  description="Lash, brow and eye treatments in Bermondsey, London SE1. Defined, polished results at Sara Monse Beauty — book lash and brow services online."
  videoWebmSrc="/assets/eyes-hero.small.webm?t=1"
  videoMp4Src="/assets/eyes-hero.small.mp4?t=1"
  videoPoster="/assets/eyes-hero-poster.webp"
  footerTheme="dark"
>
  <ServiceIntro
    title="Eyes"
    description="Enhance and define your natural beauty with our eye treatments; from perfectly shaped brows to long-lasting lash extensions and more."
  />

  <!-- Treatments -->
  <section class="px-6 sm:px-8 pt-12 sm:pt-16 lg:pt-20 pb-20 sm:pb-24 lg:pb-28">
    <div class="max-w-3xl mx-auto divide-y divide-gray-200">
      <MenuBlocks blocks={eyesRows} />
    </div>
  </section>

  <!-- Upcoming -->
  <section class="px-6 sm:px-8 pt-16 sm:pt-20 lg:pt-24 pb-20 sm:pb-24 lg:pb-28">
    <div class="max-w-3xl mx-auto">
      {eyesComing && eyesComing.type === 'comingSoon' && <MenuBlocks blocks={[eyesComing]} />}
    </div>
  </section>

  <!-- CTA -->
  <section class="pt-12 sm:pt-16 lg:pt-20 pb-16 sm:pb-20 lg:pb-24 px-6 sm:px-8">
    <ServiceMenuDownloads menu={eyesMenu} primaryRowClass="justify-center" centerDownloads={true}>
      <a
        href={FRESHA_BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-linear-to-r from-amber-400 via-orange-400 to-pink-500 text-white font-sans text-sm tracking-[0.2em] uppercase px-10 py-5 hover:opacity-90 transition-opacity"
        >Book Treatment</a
      >
    </ServiceMenuDownloads>
  </section>

  <FaqAccordion
    heading="Common questions"
    items={serviceFaqs.eyes}
    defaultOpenCount={0}
    class="bg-[#f8f6f3] !pt-4 sm:!pt-6 lg:!pt-8"
  />
</VideoHeroLayout>
