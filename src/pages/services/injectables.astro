---
import VideoHeroLayout from '../../layouts/VideoHeroLayout.astro';
import ServiceIntro from '../../components/ServiceIntro.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import MenuBlocks from '../../components/menus/MenuBlocks.astro';
import MenuFatDissolve from '../../components/menus/MenuFatDissolve.astro';
import ServiceMenuDownloads from '../../components/ServiceMenuDownloads.astro';
import { serviceFaqs } from '../../data/faq-content.js';
import {
  injectablesFatDissolveBlock,
  injectablesMenu,
  injectablesRestBlocks,
} from '../../data/menus/injectables';
import { FRESHA_BOOKING_URL } from '../../data/site-urls.js';
---

<VideoHeroLayout
  title="Injectables & skin treatments | Sara Monse Beauty"
  description="Professional injectable and skin treatments in Bermondsey, SE1. Natural-looking, refined results at Sara Monse Beauty, London — book a consultation."
  videoWebmSrc="/assets/injectables-hero.small.webm?t=1"
  videoMp4Src="/assets/injectables-hero.small.mp4?t=1"
  videoPoster="/assets/injectables-hero-poster.webp"
  footerTheme="dark"
>
  <ServiceIntro
    title="Injectables"
    description="Targeted injectable treatments designed to refine, rejuvenate and restore; delivering natural results with advanced techniques."
  />

  <!-- Fat Dissolve Injections -->
  <section class="px-6 sm:px-8 pt-20 sm:pt-24 lg:pt-28 pb-24 sm:pb-28 lg:pb-32">
    <div class="max-w-4xl mx-auto">
      <MenuFatDissolve block={injectablesFatDissolveBlock} />
    </div>
  </section>

  <!-- Vitamin B12 & Profhilo -->
  <section class="px-6 sm:px-8 pt-20 sm:pt-24 lg:pt-28 pb-20 sm:pb-24 lg:pb-28">
    <div class="max-w-4xl mx-auto divide-y divide-gray-200">
      <MenuBlocks blocks={injectablesRestBlocks} />
    </div>
  </section>

  <!-- CTA -->
  <section class="pt-12 sm:pt-16 lg:pt-20 pb-16 sm:pb-20 lg:pb-24 px-6 sm:px-8">
    <ServiceMenuDownloads menu={injectablesMenu}>
      <a
        href={FRESHA_BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-linear-to-r from-amber-400 via-orange-400 to-pink-500 text-white font-sans text-sm tracking-[0.2em] uppercase px-10 py-5 hover:opacity-90 transition-opacity"
        >Book Treatment</a
      >
    </ServiceMenuDownloads>
  </section>

  <FaqAccordion
    heading="Common questions"
    items={serviceFaqs.injectables}
    defaultOpenCount={0}
    class="bg-[#f8f6f3] !pt-4 sm:!pt-6 lg:!pt-8"
  />
</VideoHeroLayout>
