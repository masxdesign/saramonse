---
import VideoHeroLayout from '../../layouts/VideoHeroLayout.astro';
import ServiceIntro from '../../components/ServiceIntro.astro';
import ServiceMenuDownloads from '../../components/ServiceMenuDownloads.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import MenuBlocks from '../../components/menus/MenuBlocks.astro';
import { serviceFaqs } from '../../data/faq-content.js';
import {
  nailsFeetSectionBlocks,
  nailsHandsSectionBlocks,
  nailsMenu,
  nailsRemovalBlocks,
} from '../../data/menus/nails';
import { FRESHA_BOOKING_URL } from '../../data/site-urls.js';
---

<VideoHeroLayout
  title="Nail treatments | Sara Monse Beauty"
  description="Manicures, pedicures, BIAB and Gel-X extensions in Bermondsey, London SE1. Expert nails at Sara Monse Beauty. Book online."
  videoWebmSrc="/assets/nails-hero.small.webm?t=1"
  videoMp4Src="/assets/nails-hero.small.mp4?t=1"
  videoPoster="/assets/nails-hero-poster.webp"
  footerTheme="dark"
>
  <ServiceIntro
    variant="layout2"
    title="Nails"
    imageSrc="/assets/nails-intro.webp"
    imageAlt="French manicure with soft pink base, white tips, and a glitter accent nail"
  >
    <h2
      class="text-sm sm:text-base font-sans font-semibold tracking-[0.15em] uppercase text-gray-900"
    >
      Monse Studio × Sara Monse Beauty
    </h2>
    <p class="text-body-intro">
      Monse Studio is our dedicated nail studio, based within Sara Monse Beauty in Bermondsey, London SE1.
    </p>
    <p class="text-body-intro">
      Specialising in considered manicures, BIAB, gel and soft gel extensions, Monse Studio brings a modern,
      detail-led approach to every set.
    </p>
    <p class="text-body-intro">
      Discover our latest work on Instagram{' '}
      <a
        href="https://www.instagram.com/monsestudiolondon/"
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-2 hover:text-gray-900"
        >@monsestudiolondon</a
      >
    </p>
  </ServiceIntro>

  <!-- Treatments -->
  <section class="px-6 sm:px-8 pt-12 sm:pt-16 lg:pt-20 pb-20 sm:pb-24 lg:pb-28">
    <div class="max-w-3xl mx-auto">
      <h2
        class="text-2xl sm:text-3xl lg:text-4xl text-gray-900 font-light tracking-[0.3em] uppercase mb-6"
        style="font-family: 'Cormorant Garamond', 'Georgia', serif;"
      >
        Hands
      </h2>

      <div class="divide-y divide-gray-200">
        <MenuBlocks blocks={nailsHandsSectionBlocks} />
      </div>

      <h2
        class="text-2xl sm:text-3xl lg:text-4xl text-gray-900 font-light tracking-[0.3em] uppercase mt-16 sm:mt-20 lg:mt-24 mb-6"
        style="font-family: 'Cormorant Garamond', 'Georgia', serif;"
      >
        Feet
      </h2>

      <div class="divide-y divide-gray-200">
        <MenuBlocks blocks={nailsFeetSectionBlocks} />
      </div>

      <h2
        class="text-2xl sm:text-3xl lg:text-4xl text-gray-900 font-light tracking-[0.3em] uppercase mt-24 sm:mt-28 lg:mt-32 mb-10 sm:mb-12"
        style="font-family: 'Cormorant Garamond', 'Georgia', serif;"
      >
        Removal
      </h2>

      <div class="space-y-10">
        <MenuBlocks blocks={nailsRemovalBlocks} />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pt-12 sm:pt-16 lg:pt-20 pb-16 sm:pb-20 lg:pb-24 px-6 sm:px-8">
    <ServiceMenuDownloads menu={nailsMenu} primaryRowClass="justify-center" centerDownloads={true}>
      <a
        href={FRESHA_BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-linear-to-r from-amber-400 via-orange-400 to-pink-500 text-white font-sans text-sm tracking-[0.2em] uppercase px-10 py-5 hover:opacity-90 transition-opacity"
        >Book Treatment</a
      >
    </ServiceMenuDownloads>
  </section>

  <FaqAccordion
    heading="Common questions"
    items={serviceFaqs.nails}
    defaultOpenCount={0}
    class="bg-[#f8f6f3] !pt-4 sm:!pt-6 lg:!pt-8"
  />
</VideoHeroLayout>
